{
  "name": "central-pdf",
  "version": "1.2.0",
  "releaseVersion": "1.2.0",
  "buildLabel": "2026.07.26.1",
  "description": "Secure local PDF manipulation tool for Windows",
  "author": "ITSM",
  "main": "src/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "start": "electron .",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "build:win": "powershell -ExecutionPolicy Bypass -File .\\scripts\\build-win.ps1",
    "dist": "npm run build && electron-builder",
    "dist:win": "powershell -ExecutionPolicy Bypass -File .\\scripts\\build-win.ps1",
    "test:assets": "node .\\scripts\\testing\\generate-test-assets.js",
    "test:functional": "node .\\scripts\\testing\\run-functional-tests.js",
    "test:queue": "node .\\scripts\\testing\\run-queue-tests.js",
    "test:security": "node .\\scripts\\testing\\run-security-audit.js",
    "test:architecture": "node .\\scripts\\testing\\run-architecture-audit.js",
    "test:repo": "node .\\scripts\\testing\\run-repo-audit.js",
    "test:performance": "node .\\scripts\\testing\\run-performance-smoke.js",
    "test:startup": "node .\\scripts\\testing\\run-startup-benchmark.js",
    "test:visual": "node .\\scripts\\testing\\run-visual-audit.js",
    "test:ui-smoke": "node .\\scripts\\testing\\run-ui-smoke.js",
    "test:ui-app": "node .\\scripts\\testing\\run-ui-app-e2e.js",
    "test:build": "node .\\scripts\\testing\\run-build-check.js",
    "health-check": "node .\\scripts\\testing\\health-check.js",
    "release-check": "node .\\scripts\\testing\\release-check.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@pdfsmaller/pdf-decrypt": "^1.0.1",
    "@pdfsmaller/pdf-encrypt": "^1.0.2",
    "docx": "^9.7.1",
    "mammoth": "^1.12.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fluentui/react-icons": "^2.0.334",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.7",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "vite": "^8.1.5"
  }
}
